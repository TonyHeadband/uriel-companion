{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Uriel",
  "version": "0.1.0",
  "identifier": "com.homelab-station.uriel-companion",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Uriel",
        "width": 420,
        "height": 640,
        "resizable": true,
        "minWidth": 340,
        "minHeight": 480
      },
      {
        "label": "settings",
        "title": "Uriel settings",
        "url": "settings.html",
        "width": 460,
        "height": 620,
        "minWidth": 340,
        "minHeight": 320,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https: http://127.0.0.1:* http://localhost:* ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
